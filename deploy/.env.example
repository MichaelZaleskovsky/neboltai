POSTGRES_USER=neboltai
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=neboltai
MINIO_ROOT_PASSWORD=CHANGE_ME

# ARM64/Ampere A1 compatible Cantaloupe image.
# Set this to the image you already selected for the VM.
CANTALOUPE_IMAGE=CHANGE_ME_TO_ARM64_CANTALOUPE_IMAGE

# Public URL used by artwork-service when it creates external links.
# Example: http://130.61.19.127:8080
PUBLIC_BASE_URL=http://YOUR_VM_PUBLIC_IP:8080
